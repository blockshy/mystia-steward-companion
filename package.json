{
  "name": "mystia-steward-companion",
  "description": "mystia-steward-companion - 东方夜雀食堂 BepInEx Mod 与桌面伴随窗口",
  "private": true,
  "version": "1.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/companion/vite.config.ts",
    "build": "tsc -b apps/companion/tsconfig.json && vite build --config apps/companion/vite.config.ts",
    "lint": "eslint .",
    "artifacts:report": "node scripts/manage-build-artifacts.mjs report",
    "artifacts:prune": "node scripts/manage-build-artifacts.mjs prune",
    "artifacts:clean": "node scripts/manage-build-artifacts.mjs clean",
    "icons:generate": "node scripts/generate-icon-assets.mjs",
    "icons:check": "node scripts/generate-icon-assets.mjs --check",
    "mock:api": "node scripts/mock-local-api.mjs",
    "audit:ui": "node scripts/playwright-ui-audit.mjs",
    "audit:custom-recipes": "node tests/custom-recipes/frontend-custom-recipes-audit.mjs",
    "audit:automation": "node tests/automation/cooker-slot-scheduling-audit.mjs && node --experimental-strip-types tests/automation/frontend-automation-recovery-audit.mjs && node tests/automation/runtime-side-effect-audit.mjs",
    "audit:recommendations": "node --experimental-strip-types tests/recommendations/primary-execution-plan-audit.mjs && node --experimental-strip-types tests/recommendations/yuyuko-phase-evaluation-audit.mjs && node --experimental-strip-types tests/recommendations/yuuma-challenge-audit.mjs && node --experimental-strip-types tests/recommendations/order-presentation-audit.mjs && node --experimental-strip-types tests/recommendations/infinite-inventory-audit.mjs && node --experimental-strip-types tests/recommendations/blocked-diagnostics-audit.mjs",
    "audit:connection-recovery": "node --experimental-strip-types tests/connection-recovery/connection-recovery-audit.mjs",
    "audit:font-scale": "node tests/font-scale/font-scale-playwright.mjs",
    "audit:settings-help": "node tests/settings-help/settings-help-playwright.mjs",
    "audit:updates": "node --experimental-strip-types tests/update-ui/update-ui-audit.mjs",
    "audit:updates:ui": "node tests/update-ui/update-notice-playwright.mjs",
    "audit:ui-pinning": "node tests/ui-pinning/frontend-ui-pinning-audit.mjs",
    "audit:special-business": "node tests/special-business/challenge-display-name-audit.mjs && node tests/special-business/target-state-audit.mjs && node tests/special-business/runtime-catalog-audit.mjs && dotnet run --project tests/runtime-yuuma-special-business/RuntimeYuumaSpecialBusinessSmoke.csproj -c Release && dotnet run --project tests/runtime-yuuma-finalization/RuntimeYuumaFinalizationSmoke.csproj -c Release && dotnet run --project tests/yuuma-cooker-topology/YuumaCookerTopologySmoke.csproj -c Release",
    "audit:runtime-yuuma-special-business": "dotnet run --project tests/runtime-yuuma-special-business/RuntimeYuumaSpecialBusinessSmoke.csproj -c Release",
    "audit:runtime-yuuma-finalization": "dotnet run --project tests/runtime-yuuma-finalization/RuntimeYuumaFinalizationSmoke.csproj -c Release",
    "audit:yuuma-cooker-topology": "dotnet run --project tests/yuuma-cooker-topology/YuumaCookerTopologySmoke.csproj -c Release",
    "audit:rare-guest-invitations": "node --experimental-strip-types tests/rare-guest-invitations/frontend-rare-guest-invitations-audit.mjs",
    "audit:rare-guest-invitations:ui": "node tests/rare-guest-invitations/rare-guest-invitations-playwright.mjs",
    "audit:gamepad": "node --experimental-strip-types tests/gamepad-input/gamepad-input-engine-audit.mjs && node scripts/playwright-gamepad-audit.mjs",
    "audit:logs:console": "node --experimental-strip-types tests/console-window/loopback-endpoint-audit.mjs && node tests/console-window/bepinex-console-playwright.mjs",
    "audit:runtime-missions": "node tests/runtime-mission-diagnostic/runtime-mission-diagnostic-audit.mjs && node tests/runtime-available-missions/runtime-available-missions-audit.mjs && node --experimental-strip-types tests/tracked-missions/tracked-missions-audit.mjs && node --experimental-strip-types tests/available-missions/available-missions-audit.mjs",
    "audit:runtime-missions:ui": "node tests/tracked-missions/tracked-missions-playwright.mjs",
    "audit:build-artifacts": "node tests/build-artifacts/build-artifacts-audit.mjs",
    "audit:release-package": "bash tests/build-artifacts/release-package-transaction-audit.sh",
    "audit:android-apk-transaction": "node tests/build-artifacts/android-apk-transaction-audit.mjs",
    "audit:release-policy": "node tests/build-artifacts/release-script-policy-audit.mjs",
    "preview": "vite preview --config apps/companion/vite.config.ts",
    "tauri:dev": "node scripts/manage-build-artifacts.mjs prune && cd apps/companion && tauri dev",
    "tauri:build": "node scripts/manage-build-artifacts.mjs prune && cd apps/companion && tauri build --no-bundle",
    "tauri:android:dev": "node scripts/manage-build-artifacts.mjs prune && cd apps/companion && tauri android dev",
    "tauri:android:build": "node scripts/manage-build-artifacts.mjs prune && cd apps/companion && tauri android build",
    "tauri:android:apk": "node scripts/manage-build-artifacts.mjs prune && cd apps/companion && tauri android build --apk --split-per-abi --target aarch64 armv7",
    "tauri:android:apk:signed": "node scripts/build-android-signed-apk.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.60.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10"
    }
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
