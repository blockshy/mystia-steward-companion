    "flutter:generated-check": "node scripts/flutter-workspace.mjs --task generated-check",
    "flutter:test": "node scripts/flutter-workspace.mjs --task test",
    "flutter:build-windows": "node scripts/flutter-workspace.mjs --task build-windows",
    "flutter:build-android": "node scripts/flutter-workspace.mjs --task build-android",
    "flutter:verify": "node scripts/flutter-workspace.mjs --task verify",
