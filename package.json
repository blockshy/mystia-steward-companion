    "audit:windows-runtime": "node tests/build-artifacts/windows-runtime-audit.mjs",
    "audit:release-policy": "node tests/update-catalog/update-catalog-audit.mjs && node tests/build-artifacts/release-script-policy-audit.mjs && pwsh -NoLogo -NoProfile -File tests/build-artifacts/release-powershell-runtime-audit.ps1 && node tests/github-actions/release-workflow-audit.mjs && node tests/flutter-release/release-policy-audit.mjs",
    "audit:github-actions": "node tests/github-actions/release-workflow-audit.mjs",
