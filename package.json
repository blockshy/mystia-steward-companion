    "flutter:verify-unit": "node scripts/flutter-workspace.mjs --task verify-unit",
    "flutter:contracts-test": "node scripts/flutter-workspace.mjs --task contracts-test",
    "flutter:contracts-unit": "node scripts/flutter-workspace.mjs --task contracts-unit"
