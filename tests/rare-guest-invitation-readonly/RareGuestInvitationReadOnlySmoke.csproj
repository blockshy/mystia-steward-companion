<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <ReferenceDir Condition="'$(ReferenceDir)' == ''">../../mods/bepinex/References</ReferenceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../mods/bepinex/src/Save/RuntimeConcreteCollectionReader.cs" Link="RuntimeConcreteCollectionReader.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeRareGuestInvitationCandidate.cs" Link="RuntimeRareGuestInvitationCandidate.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeRareGuestInvitationIdentity.cs" Link="RuntimeRareGuestInvitationIdentity.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeSchedulerCharacterIdentity.cs" Link="RuntimeSchedulerCharacterIdentity.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeRareGuestInvitationWriteGuard.cs" Link="RuntimeRareGuestInvitationWriteGuard.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeTrackedNpcAvailability.cs" Link="RuntimeTrackedNpcAvailability.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(ReferenceDir)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(ReferenceDir)/Il2Cppmscorlib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
