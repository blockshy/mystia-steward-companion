<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <ReferenceDir Condition="'$(ReferenceDir)' == ''">../../mods/bepinex/References</ReferenceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../mods/bepinex/src/Save/RuntimeConcreteCollectionReader.cs" Link="RuntimeConcreteCollectionReader.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeRareGuestReader.cs" Link="RuntimeRareGuestReader.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeCoreMappingProjection.cs" Link="RuntimeCoreMappingProjection.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeDaySceneReadinessState.cs" Link="RuntimeDaySceneReadinessState.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeReflectionUtility.cs" Link="RuntimeReflectionUtility.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeCookerTypeSequenceReader.cs" Link="RuntimeCookerTypeSequenceReader.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeStorageStateProjection.cs" Link="RuntimeStorageStateProjection.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(ReferenceDir)/Il2CppSystem.Core.dll</HintPath>
      <Private>true</Private>
      <!-- 使用别名隔离真实 783 元数据与故障注入集合；测试不会创建真实原生对象。 -->
      <Aliases>RuntimeCore</Aliases>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ReferenceDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(ReferenceDir)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(ReferenceDir)/Il2Cppmscorlib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
