<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <ReferenceDir Condition="'$(ReferenceDir)' == ''">$(MSBuildProjectDirectory)\..\..\mods\bepinex\References</ReferenceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../mods/bepinex/src/Save/AutomationOrderConfigurationPolicy.cs" Link="AutomationOrderConfigurationPolicy.cs" />
    <Compile Include="../../mods/bepinex/src/Save/AutomationCookerStartPolicy.cs" Link="AutomationCookerStartPolicy.cs" />
    <Compile Include="../../mods/bepinex/src/Save/AutomationCookingJobLifecycle.cs" Link="AutomationCookingJobLifecycle.cs" />
    <Compile Include="../../mods/bepinex/src/Save/AutomationSafetyBarrierRegistry.cs" Link="AutomationSafetyBarrierRegistry.cs" />
    <Compile Include="../../mods/bepinex/src/Save/CookControllerFoodResultIdentity.cs" Link="CookControllerFoodResultIdentity.cs" />
    <Compile Include="../../mods/bepinex/src/Save/RuntimeCookerReservation.cs" Link="RuntimeCookerReservation.cs" />
    <Compile Include="../../mods/bepinex/src/Save/SpecialBusiness/SpecialFoodTargetPolicy.cs" Link="SpecialFoodTargetPolicy.cs" />
    <Compile Include="../../mods/bepinex/src/Save/SpecialBusiness/YuyukoFoodModifierContract.cs" Link="YuyukoFoodModifierContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
    <Reference Include="0Harmony">
      <HintPath>$(ReferenceDir)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(ReferenceDir)\MonoMod.RuntimeDetour.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(ReferenceDir)\MonoMod.Utils.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
